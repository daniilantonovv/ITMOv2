# Короткий чат-режим: Qwen 3.5 4B (Q4_K_M, ~3.4 GB) на Apple M4 / 16 GB.
# Сборка: ollama create itmo-local -f Modelfile
FROM qwen3.5:4b
# 4k контекста хватает на README + вопрос и держит KV-кэш маленьким.
PARAMETER num_ctx 4096
# Низкая температура: ответы по фактам, а не творчество.
PARAMETER temperature 0.2
PARAMETER top_p 0.9
# Ограничиваем длину ответа, чтобы модель не «растекалась».
PARAMETER num_predict 512
SYSTEM """Ты помощник по учебному проекту. Отвечай по-русски и только по предоставленным фактам.
Если данных нет, напиши «В предоставленных материалах нет ответа».
Если в вопросе ложная предпосылка (например, несуществующая функция или файл), прямо скажи об этом.
Не выдумывай файлы, CI и настройки. Дай короткий ответ и основание."""
