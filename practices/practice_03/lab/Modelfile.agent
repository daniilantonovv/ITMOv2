# Модель для OpenCode: тот же Qwen 3.5 4B, но с большим контекстом.
# Сборка: ollama create itmo-agent -f Modelfile.agent
FROM qwen3.5:4b
# Системный промпт OpenCode + описания инструментов ~5–6k токенов;
# при 4096 Ollama молча обрезает запрос, поэтому 64k.
PARAMETER num_ctx 65536
PARAMETER temperature 0.2
PARAMETER top_p 0.9
# Запасной system prompt: OpenCode передаёт свой, этот работает при прямом чате.
SYSTEM """Ты помощник по учебному репозиторию. Сначала читай файлы, потом отвечай.
Не выдумывай CI, зависимости, функции или настройки.
Если данных нет, напиши «В предоставленных материалах нет ответа».
Формат: короткий ответ, затем основание (файл и строка)."""
